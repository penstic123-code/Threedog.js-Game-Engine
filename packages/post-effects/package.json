{
  "name": "@threedog/post-effects",
  "version": "1.1.0",
  "description": "Optional post effects for threedog: bloom, ambient occlusion, outline, LUT color grading, film grain, vignette, chromatic aberration and depth of field (light ldr effects are fused into one fullscreen pass)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/penstic123-code/Threedog.js-Game-Engine.git",
    "directory": "packages/post-effects"
  },
  "homepage": "https://github.com/penstic123-code/Threedog.js-Game-Engine#readme",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./tsl": {
      "types": "./tsl.d.ts",
      "default": "./tsl.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "*.js",
    "*.d.ts"
  ],
  "peerDependencies": {
    "threedog": "^1.1.0",
    "three": "^0.187.0"
  }
}
