{
  "name": "threedog",
  "version": "1.2.0",
  "description": "Web 3D game engine on three.js: core + optional modules, no built-in art (the picture comes from your own style), built to be driven by an AI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/penstic123-code/Threedog.js-Game-Engine.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/penstic123-code/Threedog.js-Game-Engine#readme",
  "bugs": {
    "url": "https://github.com/penstic123-code/Threedog.js-Game-Engine/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./error-hints": "./core/base/errorHints.js",
    "./spelling": "./core/base/spelling.js",
    "./model-needs": "./core/assets/modelNeeds.js",
    "./metadata": "./core/inspect/metadata.generated.js",
    "./grid": "./core/scene/grid.js",
    "./draw-only": "./core/scene/drawOnly.js",
    "./layers": "./render/layers.js",
    "./pixel": {
      "types": "./types/pixel.d.ts",
      "default": "./core/scene/pixel.js"
    },
    "./worker": {
      "types": "./types/worker.d.ts",
      "default": "./core/threads/threadServe.js"
    },
    "./tsl": {
      "types": "./types/tsl.d.ts",
      "default": "./render/fx/index.js"
    },
    "./modules/*.contract.js": "./modules/*.contract.js",
    "./modules/*/contract.js": "./modules/*/contract.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "presets.js",
    "core",
    "modules",
    "render",
    "ui",
    "types",
    "docs",
    "examples",
    "CHANGELOG.md",
    "llms.txt"
  ],
  "sideEffects": [
    "./core/assets/assetLod.js",
    "./core/stream/Batching.js",
    "./core/engine/Engine.js",
    "./core/scene/gameLights.js",
    "./core/engine/page.js",
    "./core/threads/pureWorker.js",
    "./core/scene/sceneDelta.js",
    "./modules/camera/FirstPersonCamera.js",
    "./modules/camera/FixedCamera.js",
    "./modules/camera/FollowCamera.js",
    "./modules/camera/RtsCamera.js",
    "./modules/characters/pathWorker.js",
    "./modules/sky/Sky.js",
    "./modules/terrain/ChunkManager.js",
    "./modules/terrain/chunkWorker.js",
    "./modules/world/World.js",
    "./render/backend.js",
    "./render/cascades.tsl.js",
    "./render/detail.js",
    "./render/effects.js",
    "./render/fx/index.js",
    "./render/fx/particles.tsl.js",
    "./render/fx/compareLevel.tsl.js",
    "./render/fx/patchNodes.tsl.js",
    "./render/fx/postWebGPU.tsl.js",
    "./render/fx/sky.tsl.js",
    "./render/impostor.tsl.js",
    "./render/lighting.js",
    "./render/ownFrame.js",
    "./render/patches.js",
    "./render/postWebGL.js",
    "./render/recordSweep.js",
    "./render/shadowCache.tsl.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "threedog test",
    "map": "threedog map"
  },
  "peerDependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@recast-navigation/core": "^0.44.0",
    "@recast-navigation/generators": "^0.44.0",
    "@recast-navigation/three": "^0.44.0",
    "@types/three": "~0.187.0",
    "three-mesh-bvh": "^0.9.17"
  }
}
