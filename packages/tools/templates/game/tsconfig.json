{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": []
  },
  "include": ["**/*.js", "**/*.d.ts"],
  "exclude": ["node_modules", "dist", "vendor", ".threedog", "public", "tests", "vite.config.js"]
}
